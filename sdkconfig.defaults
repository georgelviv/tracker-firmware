# LilyGO T-A7670G R2 with L76K GPS (ESP32-WROVER-E, 4MB flash)
CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
# Google serves GTS Root R1/R4 cross-signed by the retired "GlobalSign Root CA";
# this lets the bundle match GTS roots in the middle of the chain.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_CROSS_SIGNED_VERIFY=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# Mobile data over PPP through the A7670 (esp_modem).
CONFIG_LWIP_PPP_SUPPORT=y
CONFIG_LWIP_PPP_PAP_SUPPORT=y
CONFIG_LWIP_PPP_ENABLE_IPV6=n
# DNS follows the active link (Wi-Fi or LTE).
CONFIG_ESP_NETIF_SET_DNS_PER_DEFAULT_NETIF=y
